                <FpsTargetDetector>500, 0, 0, 0, 1, 20000, 1, 40000</FpsTargetDetector>
                <FpsQualityJudger>1, 500, 120, 0, 120, 0, 0, 500, 1, 5000</FpsQualityJudger>
                <ThermalQualityJudger>1, 1000, 60000, 20000, 5000, 2000, 2000, 0, 1000</ThermalQualityJudger><!-- 40/35 degC -->
                <CpuJudger>0, 10000, 80000, 60000</CpuJudger>
                <CpuManagers>
                    <CpuManager>perf_set_cpu_cap_for_game_with_thermal_limit_low, 1, 100, 60, 2, 500, 10000, 10, 20, 2
                        <WeightsSet>
                            <Weights>100, 100,   0</Weights><!-- high perf(low temp) -->
                            <Weights>100,   0, 100</Weights><!-- mid perf(mid temp) -->
                            <Weights>  0, 100, 100</Weights><!-- low perf(high temp) -->
                        </WeightsSet>
                    </CpuManager>
                </CpuManagers>
            </Config>
