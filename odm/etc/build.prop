##### Overwrite prop values by composition #####
ro.odm.build.id=71.0.A.2.22

####################################
# from generate-common-build-props
# These properties identify this partition image.
####################################
ro.product.odm.brand=Sony
ro.product.odm.device=pdx256
ro.product.odm.manufacturer=Sony
ro.product.odm.model=Pdx256
ro.product.odm.name=pdx256
ro.odm.product.cpu.abilist=arm64-v8a
ro.odm.product.cpu.abilist32=
ro.odm.product.cpu.abilist64=arm64-v8a
ro.odm.build.date=Thu Apr  3 03:07:54 JST 2025
ro.odm.build.date.utc=1743617274
ro.odm.build.fingerprint=Sony/pdx256/pdx256:15/AQ3A.241126.002/SHIMANTO-1.0.0-REL-250402-1707:user/release-keys
ro.odm.build.tags=release-keys
ro.odm.build.type=user
ro.odm.build.version.incremental=SHIMANTO-1.0.0-REL-250402-1707
ro.odm.build.version.release=15
ro.odm.build.version.release_or_codename=15
ro.odm.build.version.sdk=35
####################################
# from device/somc/shimanto/odm.prop
####################################
#
# platform specific part of odm.prop
#
# PCC matrix default values : pcc[0].R,pcc[0].G,pcc[0].B,pcc[1].R,pcc[1].G,pcc[1].B
persist.vendor.display.pcc_matrix=0.000000,0.000000,0.000000,0.000000,0.000000,0.000000
# Display Color change control
ro.vendor.display.color_change.interval=20
ro.vendor.display.color_change.repeat=15
# Display
vendor.enable.always_on_display=0
vendor.backlight_on=0
# Display FLM control
ro.vendor.display.flm.hdr_lux_start_point=10000
ro.vendor.display.flm.hdr_lux_stop_point=5000
vendor.display.panel_flm2_mode=1
# Enable Color-Gamut
persist.vendor.display.colorgamut.mode=1
persist.vendor.display.sspp_color_mode=1
# RID010783
ro.odm.service.fpscontroller.supported=true
# disable data roaming
ro.com.android.dataroaming=false
# property to turn off CdmaLTEPhone always
telephony.lteOnCdmaDevice=0
# Display LTM control
ro.vendor.display.ltm.lux_start_point=5000
# Import sony customizations from config.prop
import /odm/etc/customization/${ro.boot.hardware.sku}/config.prop
# Display Combined light sensor support
ro.vendor.display.light_sensor_idx.flm=6
ro.vendor.display.light_sensor_idx.ltm=0
ro.vendor.display.light_sensor_idx.rhd=1
ro.vendor.display.light_sensor_idx.acm=6
# Setup Wizard
ro.com.android.prov_mobiledata=false
# lmkd
# 1/18 of total memory
ro.lmk.critical_available_threshold=18
####################################
# from device/somc/pdx256/odm.prop
####################################
#
# product common part of odm.prop
#
# Display
ro.vendor.display.panel_resolution=1080,2340
ro.vendor.display.panel_max_brightness_nit=1500
# Audio
vendor.audio.3rd_mic_attached=true
####################################
# from variable ADDITIONAL_ODM_PROPERTIES
####################################
ro.vendor.qti.va_odm.support=1
####################################
# from variable PRODUCT_ODM_PROPERTIES
####################################
persist.vendor.qcom.bluetooth.aac_abr_support=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_2_support=true
persist.vendor.qcom.bluetooth.lossless_aptx_adaptive_le.enabled=false
vendor.somc.lea_switch.support=true
ro.surface_flinger.enable_frame_rate_override=0
# end of file

